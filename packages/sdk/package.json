{
  "name": "mail-buddy-sdk",
  "version": "0.1.0",
  "description": "Typed Node.js client SDK for Mail Buddy - a self-hostable email template manager and delivery API.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mail-buddy",
    "email",
    "transactional-email",
    "handlebars",
    "sdk"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shakthizen/mail-buddy.git",
    "directory": "packages/sdk"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "bun-types": "^1.3.14",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
