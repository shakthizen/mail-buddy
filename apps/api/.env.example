# Copy this file to .env next to the compiled `mail-buddy` binary (or into
# apps/api during development) and fill in what you need. Bun loads .env
# automatically from the working directory the binary is run from - no flags
# or extra setup required. Every value below has a sane default (see
# src/env.ts) except where noted, so an empty .env is a valid starting point.

# --- Server ---
PORT=3000

# --- Storage (everything the binary itself doesn't embed lives here) ---
DATABASE_PATH=./mail-buddy.sqlite
UPLOADS_DIR=./uploads
STORAGE_PROVIDER=local
# MAX_UPLOAD_SIZE_BYTES=5242880

# --- Public URL (used to build unsubscribe links; set explicitly behind a proxy) ---
# PUBLIC_URL=https://mail.example.com

# --- Outgoing mail ---
# SMTP_FROM=no-reply@example.com

# --- Delivery worker ---
# DELIVERY_WORKER_INTERVAL_MS=5000
# DELIVERY_WORKER_BATCH_SIZE=10
# DELIVERY_WORKER_BASE_DELAY_MS=30000
# DELIVERY_WORKER_MAX_DELAY_MS=1800000

# --- Logging ---
LOG_LEVEL=info

# Note: SMTP host/port/user/password and the active storage provider's
# credentials are configured at runtime via the dashboard's
# Settings -> SMTP & Storage page (backed by PUT /api/settings), not env vars.
